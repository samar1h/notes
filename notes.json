---
layout: null
---
[{% for post in site.posts %}{"title":{{ post.title | jsonify }},"url":{{ site.baseurl | append: post.url | jsonify }},"date":{{ post.date | date: "%Y-%m-%d" | jsonify }},"excerpt":{{ post.excerpt | strip_html | strip_newlines | truncate: 200 | jsonify }},"tags":{{ post.tags | jsonify }}}{% unless forloop.last %},{% endunless %}{% endfor %}]
